# ============================================================
# SEGURANÇA — Nunca versionar credenciais ou dados sensíveis
# ============================================================

# Variáveis de ambiente e configurações secretas
.env
.env.*
*.env
!.env.example

# Chaves e certificados
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.pkcs12
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
id_dsa
*.pub

# Tokens e credenciais em arquivos de configuração
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
config/secrets.*
.netrc
.htpasswd

# AWS / Cloud credentials
.aws/
.azure/
.gcp/
gcp-credentials.json
terraform.tfvars
*.tfstate
*.tfstate.backup

